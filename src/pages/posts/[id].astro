---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const tagsArray = post.data.Tags || post.data.tags || [];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{post.data.title || post.id}</title>
    <style>
      body { max-width: 750px; margin: 0 auto; padding: 2rem; font-family: "Georgia", serif; color: #222; line-height: 1.8; }
      h1 { font-weight: normal; margin-bottom: 0.5rem; }
      .meta { color: #888; font-size: 0.9rem; margin-bottom: 2rem; }
      .tag { display: inline-block; background: #f0f0f0; color: #555; padding: 2px 8px; border-radius: 4px; margin-right: 6px; font-size: 0.85rem; text-decoration: none; }
      .tag:hover { background: #0066cc; color: #fff; }
      .back-btn { text-decoration: none; color: #666; font-size: 0.9rem; display: inline-block; margin-bottom: 2rem; }
      img { max-width: 100%; height: auto; }
    </style>
  </head>
  <body>
    <a href="/" class="back-btn">← 返回首页</a>
    
    <article>
      <h1>{post.data.title || post.id}</h1>
      <div class="meta">
        {post.data.date && <span>发布于 {new Date(post.data.date).toLocaleDateString('zh-CN')}</span>}
        {tagsArray.length > 0 && (
          <span style="margin-left: 15px;">
            标签：
            {tagsArray.map((tag: string) => (
              <a href={`/tags/${tag}`} class="tag">#{tag}</a>
            ))}
          </span>
        )}
      </div>
      <hr style="border: none; border-top: 1px solid #eee; margin-bottom: 2rem;" />
      
      <Content />
    </article>
  </body>
</html>